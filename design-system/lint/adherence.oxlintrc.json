{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/finance/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/admin/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Urbanist|Plus Jakarta Sans|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Urbanist, Plus Jakarta Sans, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|onChange|onSubmit|placeholder|tools|leading|sendLabel|minRows|disabled|style|key|ref|className|style|children)$/]",
        "message": "<AIComposer> doesn't accept that prop. Declared props: value, defaultValue, onChange, onSubmit, placeholder, tools, leading, sendLabel, minRows, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIOrb'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|thinking|src|key|ref|className|style|children)$/]",
        "message": "<AIOrb> doesn't accept that prop. Declared props: size, thinking, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:sidebar|topbar|children|drawerOpen|onDrawerClose|contentRef|className|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: sidebar, topbar, children, drawerOpen, onDrawerClose, contentRef, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|data|color|area|dashed|width|key|ref|className|style|children)$/]",
        "message": "<AreaSeries> doesn't accept that prop. Declared props: name, data, color, area, dashed, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|ring|status|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, ring, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|offline)$/]",
        "message": "<Avatar> status must be one of 'online' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|shape|icon|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, shape, icon, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|danger|warning|neutral|brand|tint|inverse|outline)$/]",
        "message": "<Badge> tone must be one of 'success' | 'danger' | 'warning' | 'neutral' | 'brand' | 'tint' | 'inverse' | 'outline'."
