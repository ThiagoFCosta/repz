# Copie para .env (público, vai no build) e .env.local (segredos, só nesta máquina). Nunca versione os dois.
# .env
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# .env.local
SUPABASE_PROJECT_REF=<projeto>
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# contas de teste do RLS (node scripts/criar-usuarios-teste.mjs cria e grava aqui)
RLS_A_EMAIL=
RLS_A_SENHA=
RLS_B_EMAIL=
RLS_B_SENHA=
